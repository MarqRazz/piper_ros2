<?xml version="1.0"?>
<!--
  load_piper: builds the kinematic/visual description of the Piper arm and
  (optionally) its gripper.

  NOTE: this macro does NOT add a <ros2_control> block. If your robot uses
  ros2_control, the caller is responsible for including
  $(find piper_description)/urdf/piper.ros2_control.xacro and calling
  xacro:piper_ros2_control (or providing its own ros2_control xacro, e.g. a
  single combined system for a multi-arm robot). See piper.urdf.xacro for an
  example.
-->
<robot name="piper" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="load_piper" params="
    parent
    prefix
    *origin
    include_gripper:=true">

    <xacro:include filename="$(find piper_description)/urdf/piper_arm_macro.xacro" />
    <xacro:piper_arm
        parent="${parent}"
        prefix="${prefix}">
      <xacro:insert_block name="origin" />  <!-- position robot given the xacro argument origin -->
    </xacro:piper_arm>

    <xacro:if value="${include_gripper}">
      <xacro:include filename="$(find piper_description)/urdf/piper_gripper_macro.xacro" />
      <xacro:piper_gripper
        parent="${prefix}tool_0"
        prefix="${prefix}">
        <origin xyz="0 0 0" rpy="0 0 0" />  <!-- gripper mounts directly to the arms tool flange -->
      </xacro:piper_gripper>
    </xacro:if>
  </xacro:macro>
</robot>
